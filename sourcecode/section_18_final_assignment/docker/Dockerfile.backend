# Backend: Spring Boot (build bằng Maven, chạy bằng JRE)
# Lưu ý: chỉnh tên file JAR theo đúng artifactId của repo đề bài.

# ---- Stage 1: build ----
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copy pom.xml trước để cache dependency
COPY pom.xml .
RUN mvn -B dependency:go-offline

# Copy source và đóng gói JAR
COPY src ./src
RUN mvn -B clean package -DskipTests

# ---- Stage 2: run ----
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Biến môi trường kết nối MongoDB (sẽ được ghi đè khi chạy trên ECS)
ENV MONGO_HOST=mongodb \
    MONGO_PORT=27017

# Copy JAR từ stage build (chỉnh tên file nếu khác)
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
