# Frontend: React (build bằng Node.js, chạy bằng nginx)
# Lưu ý: chỉnh đường dẫn build/ và API URL theo đúng cấu trúc repo của đề bài.

# ---- Stage 1: build ----
FROM node:20-alpine AS build
WORKDIR /app

# Copy file khai báo dependency trước để tận dụng Docker layer cache
COPY package*.json ./
RUN npm install

# Copy toàn bộ source và build
COPY . .
# Nếu backend URL được truyền lúc build (ví dụ REACT_APP_API_URL)
ARG REACT_APP_API_URL=http://localhost:8080
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
RUN npm run build

# ---- Stage 2: serve bằng nginx ----
FROM nginx:1.27-alpine
# Copy file build ra thư mục phục vụ của nginx
COPY --from=build /app/build /usr/share/nginx/html

# (Tuỳ chọn) cấu hình nginx để hỗ trợ SPA routing + proxy /api về backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
