{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowUploadStaticFiles",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::codebuild-artifact-<your-suffix>",
                "arn:aws:s3:::codebuild-artifact-<your-suffix>/*"
            ]
        }
    ]
}
