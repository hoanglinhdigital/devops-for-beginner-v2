region             = "ap-southeast-1"
availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]
cidr_block         = "10.30.0.0/16"
public_subnet_ips  = ["10.30.1.0/24", "10.30.2.0/24"]

# Thay 123456789012 bằng AWS Account ID của bạn, ver-1 bằng tag đã push lên ECR ở Lab 6
ecr_image_uri = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/nodejs-random-color:ver-1"

desired_count = 2
